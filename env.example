# Server reads `.env` in this folder when you run npm scripts from server/
# Full variable list: see ../env.example at repository root.

NODE_ENV=development
PORT=5000
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# SQL Server (used by `npm run db:init` and `npm run seed:sql` from server/)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=z176_exam
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_ENCRYPT=false
SQL_SERVER_TRUST_CERTIFICATE=true

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d
JWT_SECRET=
JWT_REFRESH_SECRET=

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=D:/upload
SEED_ON_START=true
DOTENV_CONFIG_QUIET=true
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_MUST_CHANGE_PASSWORD=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
BACKUP_ENCRYPTION_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
