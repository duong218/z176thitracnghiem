# Server Environment Configuration
NODE_ENV=development
PORT=5000

# SQL Server Configuration
SQL_SERVER_HOST=
SQL_SERVER_PORT=
SQL_SERVER_DATABASE=
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_SERVER_ENCRYPT=false
SQL_SERVER_TRUST_CERTIFICATE=true

# JWT Secrets
JWT_SECRET=super_secret_jwt_access_key_z176_2026_secure
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_z176_2026_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d

CORS_ORIGIN=http://localhost:5173,http://localhost:3000
UPLOAD_DIR=D:/upload
SEED_ON_START=true
DOTENV_CONFIG_QUIET=true

# Admin Seed
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_MUST_CHANGE_PASSWORD=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\xxxxxx\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
#GOOGLE_REFRESH_TOKEN 7 ngày 1 lần và sử dụng lệnh: node src/scripts/get-google-refresh-token.js để lấy mã
BACKUP_ENCRYPTION_KEY=
BACKUP_SQL_DIR=
# Số lần đăng nhập SAI tối đa cho mỗi tài khoản trong một khoảng thời gian (chỉ có tác dụng khi NODE_ENV=production)
LOGIN_RATE_LIMIT_MAX=5
# Khoảng thời gian tính, đơn vị phút
LOGIN_RATE_LIMIT_WINDOW_MINUTES=1

# Độ phức tạp băm mật khẩu Bcrypt (2^rounds vòng lặp).
# Mặc định là 12 (~250-300ms/lần). Đặt 10 (~60-80ms/lần) giúp tăng tốc độ đăng nhập gấp 4 lần,
# giảm nghẽn CPU khi hàng trăm thí sinh đồng loạt đăng nhập trước giờ thi mà vẫn an toàn tuyệt đối theo chuẩn OWASP.
BCRYPT_SALT_ROUNDS=10

#số nhân CPU
UV_THREADPOOL_SIZE=8